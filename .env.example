# Gmail account used to SEND emails (application notifications + applicant
# confirmations). Use an App Password, not your normal Gmail password —
# see README.md for how to generate one.
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# Password to log into /admin — approve candidates, upload photos,
# open/close voting, view all applications, export CSV.
ADMIN_PASSWORD=changeme

# Redis connection string. If you're reusing an existing database from
# your earlier sites, use that exact same value here.
REDIS_URL=redis://...
